{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#596F74",
      "titleColor": "#405A60",
      "domainColor": "#D9E4DE",
      "tickColor": "#D9E4DE",
      "gridColor": "#EDF1ED",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#456065",
      "titleColor": "#23414B",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "color": "#18343D",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#197E78",
        "#C17A4C",
        "#486B98",
        "#996B93",
        "#6D965B",
        "#B66568",
        "#519AAD",
        "#8D8260"
      ]
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_2025.csv"
        },
        "key": "state",
        "fields": [
          "registration_rate_16plus",
          "new_registrations"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },
  "encoding": {
    "color": {
      "field": "registration_rate_16plus",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          80
        ],
        "range": [
          "#E4F3EA",
          "#C6E3D9",
          "#92CBC3",
          "#5AA5A9",
          "#307E91",
          "#234F6F"
        ]
      },
      "legend": {
        "title": "Registered (% age 16+)"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State / territory"
      },
      {
        "field": "registration_rate_16plus",
        "title": "Registered, % age 16+"
      },
      {
        "field": "new_registrations",
        "type": "quantitative",
        "title": "New registrations 2025",
        "format": ","
      }
    ]
  },
  "usermeta": {
    "chart_number": 4,
    "proposed_advanced_idiom": true,
    "source": "DonateLife, AODR registration rate (age 16+) by state, 2025; Australian state GeoJSON",
    "note": "Map 1 of 3: choropleth",
    "boundary_source": "rowanhogan/australian-states (third-party) — origin/licence unresolved; approval/replacement required before claiming cleared rights",
    "colour_semantics": "Shared sequential teal-to-navy ramp for quantitative values; legends retain separate units and domains."
  }
}
